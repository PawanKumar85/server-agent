# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Local Neo4j in Docker (docker-compose.yml)
NEO4J_LOCAL_PASSWORD=your_local_docker_neo4j_password

# Dashboard Web Login
APP_LOGIN_EMAIL=you@example.com
APP_LOGIN_PASSWORD=change-me-to-a-strong-password
APP_SECRET_KEY=change_this_to_a_random_32_byte_hex_string

# Alert threshold: minimum consecutive failed checks (packets/pings) before triggering alerts (e.g. 10-20)
ALERT_CONSECUTIVE_THRESHOLD=10

# =============================================================================
# Model Context Protocol (MCP) Multi-Channel Notification & Escalation Integrations
# (Leave blank for Mock/Sandbox development mode; fill in for live dispatch)
# =============================================================================

# WhatsApp (Meta Cloud API)
WHATSAPP_API_TOKEN=your_meta_whatsapp_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# SMS (Twilio / Gateway)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=alerts@example.com

# ChatOps (Slack & Telegram)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_telegram_channel

# Incident Escalation (PagerDuty Events API v2)
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key


# Node Agents (../Node_Agent): tokens they connect with, comma separated (one per server is best)
AGENT_TOKENS=
